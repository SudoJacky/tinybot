{
  "name": "tinybot-desktop",
  "private": true,
  "version": "1.1.3",
  "type": "module",
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest run",
    "test:hdd": "vitest run --maxWorkers=4",
    "test:frontend-analysis": "node --experimental-vm-modules --test tools/frontend-analysis/analysis.test.mjs tools/frontend-analysis/performance-analysis.test.mjs tools/frontend-analysis/window-entry.test.mjs",
    "lint": "node tools/frontend-analysis/cli.mjs lint",
    "typecheck": "tsc --noEmit",
    "analyze:frontend": "node tools/frontend-analysis/cli.mjs full",
    "analyze:frontend:ci": "node tools/frontend-analysis/cli.mjs ci",
    "analyze:frontend:static": "node tools/frontend-analysis/cli.mjs static",
    "analyze:frontend:source": "node tools/frontend-analysis/cli.mjs source",
    "analyze:frontend:bundle": "node tools/frontend-analysis/cli.mjs bundle",
    "analyze:frontend:baseline": "node tools/frontend-analysis/cli.mjs baseline",
    "analyze:frontend:trace": "node tools/frontend-analysis/cli.mjs trace",
    "analyze:performance": "node tools/frontend-analysis/performance-analysis.mjs",
    "analyze:rust": "node -e \"const fs=require('fs');fs.rmSync('src-tauri/target/code-analysis',{recursive:true,force:true});fs.mkdirSync('src-tauri/target/code-analysis',{recursive:true})\" && rust-code-analysis-cli --metrics --paths src-tauri/src --exclude \"**/tests/**\" \"**/*_tests.rs\" --output-format json --pr --output src-tauri/target/code-analysis",
    "hooks:install": "git config core.hooksPath .githooks",
    "docs:check": "node .github/scripts/docs-freshness.mjs check",
    "help:dev": "npm --prefix website run dev --",
    "help:build": "npm --prefix website run build",
    "help:preview": "npm --prefix website run preview --",
    "docs:review": "node .github/scripts/docs-freshness.mjs review",
    "readme:check": "node .github/scripts/readme-freshness.mjs check",
    "readme:review": "node .github/scripts/readme-freshness.mjs review",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@tiptap/core": "^3.31.3",
    "@tiptap/extension-image": "^3.31.3",
    "@tiptap/extension-list": "^3.31.3",
    "@tiptap/extension-placeholder": "^3.31.3",
    "@tiptap/extension-table": "^3.31.3",
    "@tiptap/markdown": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/starter-kit": "^3.31.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "docx-preview": "0.4.0",
    "echarts": "^6.1.0",
    "gsap": "^3.15.0",
    "highlight.js": "^11.12.0",
    "i18next": "^26.4.2",
    "lucide-react": "^1.46.0",
    "ogl": "^1.0.11",
    "pptx-preview": "1.0.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.14",
    "read-excel-file": "9.3.10",
    "streamdown": "^2.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^25.9.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.5",
    "rollup-plugin-visualizer": "^7.1.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
