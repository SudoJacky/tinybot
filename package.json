{
  "name": "tinybot-desktop",
  "private": true,
  "version": "0.3.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest run",
    "test:frontend-analysis": "node --test tools/frontend-analysis/analysis.test.mjs",
    "lint": "node tools/frontend-analysis/cli.mjs lint",
    "typecheck": "tsc --noEmit",
    "analyze:frontend": "node tools/frontend-analysis/cli.mjs full",
    "analyze:frontend:ci": "node tools/frontend-analysis/cli.mjs ci",
    "analyze:frontend:static": "node tools/frontend-analysis/cli.mjs static",
    "analyze:frontend:source": "node tools/frontend-analysis/cli.mjs source",
    "analyze:frontend:bundle": "node tools/frontend-analysis/cli.mjs bundle",
    "analyze:frontend:baseline": "node tools/frontend-analysis/cli.mjs baseline",
    "analyze:frontend:trace": "node tools/frontend-analysis/cli.mjs trace",
    "analyze:rust": "node -e \"const fs=require('fs');fs.rmSync('src-tauri/target/code-analysis',{recursive:true,force:true});fs.mkdirSync('src-tauri/target/code-analysis',{recursive:true})\" && rust-code-analysis-cli --metrics --paths src-tauri/src --exclude \"**/tests/**\" \"**/*_tests.rs\" --output-format json --pr --output src-tauri/target/code-analysis",
    "hooks:install": "git config core.hooksPath .githooks",
    "docs:check": "node .github/scripts/docs-freshness.mjs check",
    "docs:review": "node .github/scripts/docs-freshness.mjs review",
    "readme:check": "node .github/scripts/readme-freshness.mjs check",
    "readme:review": "node .github/scripts/readme-freshness.mjs review",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "echarts": "^6.1.0",
    "gsap": "^3.15.0",
    "highlight.js": "^11.11.1",
    "i18next": "^26.3.6",
    "lucide-react": "^1.23.0",
    "ogl": "^1.0.11",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.11",
    "streamdown": "^2.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "happy-dom": "^20.10.1",
    "rollup-plugin-visualizer": "^7.1.1",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
